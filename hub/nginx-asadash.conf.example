# example.com —— hermes dashboard 反代
# 认证架构（2026-08-31 定稿）：
#   第 1 层 nginx：会话 cookie 存在性挡板（auth_request 不需要，
#                  直接 map cookie —— 无 cookie 302 /login，零弹窗）
#   第 2 层 hermes：会话验签（密码+cookie+CSRF）
# 0day 防护：未登录的扫描器被 nginx 302 挡在 hermes 代码之外
map $http_cookie $has_hermes_session {
    default 0;
    "~*hermes_session_at" 1;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name example.com;

    ssl_certificate /etc/nginx/ssl/example.com.crt;
    ssl_certificate_key /etc/nginx/ssl/example.com.key;

    # 永久豁免：健康探针（无敏感信息，公开 liveness）
    location = /api/health {
        proxy_pass http://127.0.0.1:9119;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # 登录页与认证端点：必须可达（否则鸡生蛋问题）
    location ~ ^/(login|auth/)(.*)?$ {
        proxy_pass http://127.0.0.1:9119;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }

    # 其余一切：cookie 挡板
    location / {
        if ($has_hermes_session = 0) {
            return 302 /login;
        }
        proxy_pass http://127.0.0.1:9119;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name example.com;
    return 301 https://$host$request_uri;
}
